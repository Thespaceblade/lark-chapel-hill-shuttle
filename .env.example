# Optional override for Motive public web-share API key (X-Web-Share-Api-Key).
# If unset, the app uses the same public key as lark_shuttle.py / Motive's share JS.
# Local: copy to .env.local
# Vercel: Project → Settings → Environment Variables (paste the key only — no quotes)
# MOTIVE_WEB_SHARE_API_KEY=

# ── Home-screen Web Push (optional; required for arrival alerts) ────────────
# Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis (REST) — free tier is enough for subscriptions
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Protects /api/notify/tick (call from external cron / Pro Vercel Cron with Bearer or ?secret=)
# CRON_SECRET=
